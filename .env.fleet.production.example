# Copy to .env.fleet.production. Deployment metadata only.
CHARGEOS_OCPP_DOMAIN=ocpp.example.net
CHARGEOS_OWNER_DOMAIN=charge.example.net
CHARGEOS_ACME_EMAIL=owner@example.net
CHARGEOS_OCPP_MAX_CONNECTIONS=16
CHARGEOS_OCPP_MAX_PAYLOAD_BYTES=1048576
CHARGEOS_OCPP_MESSAGES_PER_MINUTE=600
CHARGEOS_OCPP_MESSAGE_BURST=60
CHARGEOS_EVENT_LOG_MAX_BYTES=268435456

# Owner-only host files. Keep the containing directory mode 0700 and files
# mode 0444 for the non-root Compose secret mount. Never commit them.
CHARGEOS_STATIONS_PATH=./secrets/stations.json
CHARGEOS_OWNER_API_TOKEN_PATH=./secrets/owner-api-token

CADDY_IMAGE=caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
CHARGEOS_IMAGE=chargeos:local
