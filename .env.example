# Never reuse a vendor or personal password here.
CHARGEOS_STATION_ID=ALFEN_GENESIS
CHARGEOS_STATION_SECRET=replace-with-a-long-random-secret
# Generate with: openssl rand -hex 32
CHARGEOS_OWNER_API_TOKEN=replace-with-an-independent-long-random-owner-token
# Comma-separated owner RFID values. They are pseudonymized before persistence.
CHARGEOS_OWNER_TAGS=replace-with-owner-tag
# Multi-charger alternative: remove the three CHARGEOS_STATION_* / OWNER_TAGS
# values above and point to an owner-only mode-0600 copy of
# config/stations.example.json instead.
# CHARGEOS_STATIONS_FILE=/absolute/path/to/stations.json
CHARGEOS_OCPP_HOST=127.0.0.1
CHARGEOS_PORT=9000
CHARGEOS_OCPP_MAX_CONNECTIONS=8
CHARGEOS_OCPP_MAX_PAYLOAD_BYTES=1048576
CHARGEOS_OCPP_MESSAGES_PER_MINUTE=600
CHARGEOS_OCPP_MESSAGE_BURST=60
CHARGEOS_API_HOST=127.0.0.1
CHARGEOS_API_PORT=9080
# Enable only when a single trusted reverse proxy is the sole network peer.
CHARGEOS_TRUST_PROXY_HEADERS=false
CHARGEOS_EVENT_LOG=.chargeos/events.ndjson
CHARGEOS_EVENT_LOG_MAX_BYTES=268435456
CHARGEOS_UI_DIRECTORY=dist/ui
