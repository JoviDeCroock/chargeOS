# Copy to .env.production. This file contains deployment metadata only.
CHARGEOS_STATION_ID=ALFEN_GENESIS
CHARGEOS_OCPP_DOMAIN=ocpp.example.net
CHARGEOS_OWNER_DOMAIN=charge.example.net
CHARGEOS_ACME_EMAIL=owner@example.net
CHARGEOS_OCPP_MAX_CONNECTIONS=8
CHARGEOS_OCPP_MAX_PAYLOAD_BYTES=1048576
CHARGEOS_OCPP_MESSAGES_PER_MINUTE=600
CHARGEOS_OCPP_MESSAGE_BURST=60
CHARGEOS_EVENT_LOG_MAX_BYTES=268435456

# Paths are resolved by Docker Compose on the host. Create `secrets/` with mode
# 0700 and these files with mode 0444: Compose bind-mounts file-backed secrets,
# while chargeOS runs as a non-root user. Never commit or share the directory.
CHARGEOS_STATION_SECRET_PATH=./secrets/station-secret
CHARGEOS_OWNER_API_TOKEN_PATH=./secrets/owner-api-token
CHARGEOS_OWNER_TAGS_PATH=./secrets/owner-tags

# Refresh version and multi-platform digest together after reviewing upstream.
CADDY_IMAGE=caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
CHARGEOS_IMAGE=chargeos:local
