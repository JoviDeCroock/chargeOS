FROM node:22.23.1-alpine3.24@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS build
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.3.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build:web && pnpm service:native:build && pnpm prune --prod

FROM caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648 AS proxy
RUN setcap -r /usr/bin/caddy && chown -R 1000:1000 /data /config && chmod 700 /data /config
USER 1000:1000

FROM node:22.23.1-alpine3.24@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV SERVICE_MODE=production
ENV SERVICE_NATIVE_DATA=/data
ENV SERVICE_NATIVE_PORT=9091
ENV SERVICE_UI_DIRECTORY=/app/dist/ui
ENV SERVICE_PROXY_ONLY=loopback
ENV SERVICE_DELIVERY=smtp
ENV SERVICE_AUTH_SECRET_FILE=/run/secrets/company_auth
RUN mkdir -p /data /run/secrets && chown 1000:1000 /data && chmod 700 /data
COPY --from=build --chown=1000:1000 /app/dist/native-service ./dist/native-service
COPY --from=build --chown=1000:1000 /app/dist/ui ./dist/ui
COPY --from=build --chown=1000:1000 /app/node_modules ./node_modules
COPY --from=build --chown=1000:1000 /app/package.json ./package.json
USER 1000:1000
VOLUME ["/data"]
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=6 CMD ["node", "-e", "const u=new URL(process.env.SERVICE_ORIGIN);require('http').get({host:'127.0.0.1',port:9091,path:'/service/api/v1/health',headers:{host:u.host,'x-forwarded-proto':'https','x-chargeos-client-ip':'127.0.0.1'}},r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"]
CMD ["node", "dist/native-service/service/node/main.js"]
