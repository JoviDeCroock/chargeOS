{
	email {$CHARGEOS_ACME_EMAIL}
	admin off
}

{$CHARGEOS_OCPP_DOMAIN} {
	log {
		format json
		output stdout
	}

	reverse_proxy chargeos:9000 {
		transport http {
			max_conns_per_host {$CHARGEOS_OCPP_MAX_CONNECTIONS}
		}
	}
}

{$CHARGEOS_OWNER_DOMAIN} {
	log {
		format json
		output stdout
	}

	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'none'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self'"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
	}

	reverse_proxy chargeos:9080
}

# Internal-only BYOK relay. No published port and no access logging. The edge
# remains on its internal network; this fixed-destination relay adds no tools.
http://:9092 {
	@openai {
		method POST
		path /openai
	}
	handle @openai {
		rewrite * /v1/responses
		reverse_proxy https://api.openai.com {
			header_up Host api.openai.com
			header_up -Cookie
			header_up -Origin
		}
	}
	@anthropic {
		method POST
		path /anthropic
	}
	handle @anthropic {
		rewrite * /v1/messages
		reverse_proxy https://api.anthropic.com {
			header_up Host api.anthropic.com
			header_up X-Api-Key {http.request.header.Authorization}
			header_up -Authorization
			header_up -Cookie
			header_up -Origin
		}
	}
	handle {
		respond 404
	}
}
