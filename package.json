{
  "name": "chargeos",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm build:web && pnpm build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "continuity": "tsx server/continuity-cli.ts",
    "dev": "concurrently -k -n server,web 'pnpm dev:server' 'pnpm dev:web'",
    "dev:server": "tsx watch server/main.ts",
    "dev:web": "vite",
    "field-pack": "tsx server/field-pack-cli.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings scripts server service src test vite.config.ts vitest.service.config.ts vitest.service-native.config.mjs",
    "migration-manifest": "tsx server/migration-manifest-cli.ts",
    "simulate": "node scripts/simulate-charger.mjs",
    "start": "node dist/server/main.js",
    "test": "vitest run --reporter=verbose",
    "typecheck": "tsc --noEmit && tsc -p service/tsconfig.json",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:service && pnpm test:service:native && pnpm verify:release && pnpm build && pnpm service:build && pnpm service:native:build && pnpm verify:service-native-runtime && pnpm verify:service-mail-runtime",
    "verify:deployment": "node scripts/verify-production-deployment.mjs",
    "verify:release": "node scripts/verify-release-workflow.mjs",
    "verify:runtime": "node scripts/smoke-production-runtime.mjs",
    "service:setup": "node scripts/setup-local-service.mjs",
    "service:dev": "wrangler dev --config service/wrangler.jsonc --local",
    "service:generate": "drizzle-kit generate --config service/drizzle.config.ts",
    "service:migrate": "wrangler d1 migrations apply chargeos-commercial-local --local --config service/wrangler.jsonc",
    "service:build": "wrangler deploy --dry-run --config service/wrangler.jsonc --outdir ../dist/service",
    "test:service": "vitest run --config vitest.service.config.ts",
    "verify:ai-relay": "node scripts/verify-ai-relay.mjs",
    "deploy:setup": "node scripts/deploy.mjs",
    "verify:managed-runtime": "node scripts/verify-managed-runtime.mjs",
    "service:native": "tsx service/node/main.ts",
    "service:native:build": "node scripts/build-native-service.mjs",
    "service:native:start": "node dist/native-service/service/node/main.js",
    "service:native:outbox": "tsx service/node/outbox.ts",
    "service:native:recovery": "tsx service/node/recovery-cli.ts",
    "service:native:recovery-review": "tsx service/node/recovery-review-cli.ts",
    "service:native:recovery-enrollment": "tsx service/node/recovery-enrollment-cli.ts",
    "test:service:native": "vitest run --config vitest.service-native.config.mjs",
    "verify:service-native-runtime": "node scripts/verify-native-service.mjs",
    "service:native:recovery-release": "tsx service/node/recovery-release-cli.ts",
    "service:native:mail": "tsx service/node/mail-cli.ts",
    "verify:service-mail-runtime": "node scripts/verify-native-mail.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.14",
    "@preact/signals": "2.11.1",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "nodemailer": "10.3.1",
    "ocpp-rpc": "2.2.1",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.9",
    "@cloudflare/workers-types": "5.20261028.1",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.4",
    "@types/babel__core": "7.20.5",
    "@types/node": "22.20.1",
    "@types/ws": "8.18.1",
    "concurrently": "10.0.4",
    "drizzle-kit": "0.31.11",
    "jsdom": "30.0.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.2.4",
    "vitest": "4.1.12",
    "wrangler": "4.154.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.3.0"
}
